# 运行时状态文件（服务运行后由 worker 生成，不进版本管理）
data.json
data-multi.json
logs/

# 跨部署持久化快照（含真实账户数据，不进版本管理/不泄露到远程仓库）
multi-market/snapshot/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 下载产物（云端备份包等）
downloads/

# WorkBuddy 项目内部状态（部署绑定、工作日志，本机专属）
.workbuddy/

# 部署工具生成的归属记录
.wbapp_*.genie

# 系统/编辑器临时文件
.DS_Store
Thumbs.db
*.swp

# 一次性存档（历史脚本与状态转储，2026-11-20 归档，不参与版本管理）
_archive/

# 单次运行的取数/写回载荷（state 转储、_ctx/_reviews 等），不做版本管理
_*.json
!multi-market/*.json
